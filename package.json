{
  "name": "entre-hojas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Entre Hojas — lector de libros en PDF que se siente como un libro de papel",
  "scripts": {
    "pdfjs": "node scripts/copiar-pdfjs.mjs",
    "dev": "npm run pdfjs && vite",
    "build": "npm run pdfjs && vite build",
